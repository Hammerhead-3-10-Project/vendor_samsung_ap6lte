	$(hide) rm -rf $(dir $@)root && mkdir -p $(dir $@)root/apex $(dir $@)root/debug_ramdisk $(dir $@)root/dev $(dir $@)root/mnt $(dir $@)root/proc $(dir $@)root/sys
