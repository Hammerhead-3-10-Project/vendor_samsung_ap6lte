; Device additions to the stock Samsung policy. No permissive domains.
; Qualcomm capabilityconfigstore is shipped in stock vendor without a domain.
(type hal_capabilityconfigstore_qti_default)
(roletype object_r hal_capabilityconfigstore_qti_default)
(typeattributeset domain (hal_capabilityconfigstore_qti_default))
(typeattributeset halserverdomain (hal_capabilityconfigstore_qti_default))
(type hal_capabilityconfigstore_qti_default_exec)
(roletype object_r hal_capabilityconfigstore_qti_default_exec)
(typeattributeset file_type (hal_capabilityconfigstore_qti_default_exec))
(typeattributeset vendor_file_type (hal_capabilityconfigstore_qti_default_exec))
(typeattributeset exec_type (hal_capabilityconfigstore_qti_default_exec))
(type hal_capabilityconfigstore_qti_hwservice)
(roletype object_r hal_capabilityconfigstore_qti_hwservice)
(typeattributeset hwservice_manager_type (hal_capabilityconfigstore_qti_hwservice))
(type vendor_cap_configstore_dbg_prop)
(roletype object_r vendor_cap_configstore_dbg_prop)
(typeattributeset property_type (vendor_cap_configstore_dbg_prop))

; init_daemon_domain, with the versioned public platform symbols used by stock.
(allow init_29_0 hal_capabilityconfigstore_qti_default_exec (file (read getattr map execute open)))
(allow init_29_0 hal_capabilityconfigstore_qti_default (process (transition siginh rlimitinh)))
(allow hal_capabilityconfigstore_qti_default hal_capabilityconfigstore_qti_default_exec (file (read getattr map execute entrypoint open)))
(dontaudit init_29_0 hal_capabilityconfigstore_qti_default (process (noatsecure)))
(typetransition init_29_0 hal_capabilityconfigstore_qti_default_exec process hal_capabilityconfigstore_qti_default)

; HIDL registration and read-only configuration under /vendor/etc/configstore.
(allow hal_capabilityconfigstore_qti_default hwbinder_device_29_0 (chr_file (ioctl read write getattr lock append map open)))
(allow hal_capabilityconfigstore_qti_default hwservicemanager_29_0 (binder (call transfer)))
(allow hwservicemanager_29_0 hal_capabilityconfigstore_qti_default (binder (transfer)))
(allow hwservicemanager_29_0 hal_capabilityconfigstore_qti_default (dir (search)))
(allow hwservicemanager_29_0 hal_capabilityconfigstore_qti_default (file (read open getattr map)))
(allow hwservicemanager_29_0 hal_capabilityconfigstore_qti_default (process (getattr)))
(allow hal_capabilityconfigstore_qti_default hal_capabilityconfigstore_qti_hwservice (hwservice_manager (add find)))
(allow hal_capabilityconfigstore_qti_default hidl_base_hwservice_29_0 (hwservice_manager (add)))
(allow hal_capabilityconfigstore_qti_default vendor_configs_file_29_0 (dir (open read search getattr)))
(allow hal_capabilityconfigstore_qti_default vendor_configs_file_29_0 (file (open read getattr map)))
(allow hal_capabilityconfigstore_qti_default vendor_cap_configstore_dbg_prop (file (open read getattr map)))

; Framework/media clients may query the service, without granting untrusted app domains.
(typeattribute a6plte_capabilityconfigstore_clients)
(typeattributeset a6plte_capabilityconfigstore_clients (system_server_29_0 system_app_29_0 mediacodec))
(allow a6plte_capabilityconfigstore_clients hal_capabilityconfigstore_qti_hwservice (hwservice_manager (find)))
(allow a6plte_capabilityconfigstore_clients hal_capabilityconfigstore_qti_default (binder (call transfer)))
(allow hal_capabilityconfigstore_qti_default a6plte_capabilityconfigstore_clients (binder (transfer)))
(allow a6plte_capabilityconfigstore_clients hal_capabilityconfigstore_qti_default (fd (use)))
(allow hal_capabilityconfigstore_qti_default a6plte_capabilityconfigstore_clients (fd (use)))
(typeattribute a6plte_non_capabilityconfigstore_domains)
(typeattributeset a6plte_non_capabilityconfigstore_domains (and (domain) (not (hal_capabilityconfigstore_qti_default))))
(neverallow a6plte_non_capabilityconfigstore_domains hal_capabilityconfigstore_qti_hwservice (hwservice_manager (add)))

; The stock vendor labels /config/usb_gadget as usb_configfs, which the A11 platform rules for
; hal_usb_gadget_server (written for the plain configfs type) do not cover. Without them the AOSP
; USB gadget HAL aborts in its constructor and system_server blocks in UsbService.onBootPhase.
(allow hal_usb_gadget_qti usb_configfs (dir (open read write getattr setattr search add_name remove_name create rmdir ioctl lock)))
(allow hal_usb_gadget_qti usb_configfs (file (open read write getattr setattr create append ioctl lock map)))
(allow hal_usb_gadget_qti usb_configfs (lnk_file (read create unlink getattr)))

; Denials seen at boot on PE11 that block something real (platform types are the _29_0 names here).
; Samsung snap HAL clients: snap_hidl looks up its own ISehSnap service.
(allow snap_hidl snap_hwservice (hwservice_manager (find)))
; thermal-engine enumerates /sys/devices/virtual (thermal zones, devfreq) to find its sensors.
(allow thermal-engine sysfs_29_0 (dir (open read search getattr)))
; health HAL reads power_supply "type" files that carry the generic sysfs label.
(allow hal_health_default sysfs_29_0 (dir (open read search getattr)))
(allow hal_health_default sysfs_29_0 (file (open read getattr)))
; camera daemon reads the video node names under sysfs_graphics.
(allow mm-qcamerad sysfs_graphics (file (getattr)))
; audio HAL and ipacm open the diag node for logging.
(allow hal_audio_default diag_device (chr_file (open read write ioctl getattr)))
(allow ipacm-diag diag_device (chr_file (open read write ioctl getattr)))
; SurfaceFlinger's GPU driver looks in /vendor/firmware for the Adreno zap/microcode files.
(allow surfaceflinger_29_0 vendor_firmware_file (dir (search getattr)))
(allow surfaceflinger_29_0 vendor_firmware_file (file (open read getattr map)))
